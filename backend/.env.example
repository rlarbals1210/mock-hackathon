APP_NAME=Mov!n Matching API
# Comma-separated list of allowed origins. Add the Vercel frontend URL here in Railway env vars.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional. Defaults to ../ai/data/유연오더_가상데이터_v13.xlsx from the repository root.
# MATCHING_DATA_FILE=/absolute/path/to/유연오더_가상데이터_v13.xlsx

# Optional. Defaults to ../ai/data/out/models from the repository root.
# MATCHING_MODEL_DIR=/absolute/path/to/ai/data/out/models

# Local feedback log. Relative paths are resolved from backend/.
FEEDBACK_FILE=data/matching_feedback.jsonl

# Keep true for local UI integration when the generated workbook is not present.
# Set false in production so missing data returns DATA_NOT_READY.
ALLOW_DEMO_DATA=true
