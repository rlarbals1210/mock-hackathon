# Vercel 프로젝트 설정에서만 입력하세요. 브라우저용 VITE_ 접두사는 사용하지 않습니다.
GEMINI_API_KEY=
# gemini-flash-latest는 현재 세대 Flash 모델로 자동 해석되는 별칭입니다.
GEMINI_MODEL=gemini-flash-latest

# 매칭 API(FastAPI) 주소입니다. 로컬은 http://localhost:8000, 배포는 Railway 공개 주소입니다.
VITE_API_URL=http://localhost:8000

# 1이면 매칭 API를 호출하지 않고 frontend/src/lib/mock.ts의 고정 응답을 씁니다.
# 매칭 서버 없이 화면을 개발하거나 시연할 때 씁니다.
VITE_USE_MOCK=0

# 카카오맵 JavaScript 키입니다. 운송인 화면의 경로 지도에 필요합니다.
VITE_KAKAOMAP_API_KEY=
